{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.healthleader/conferences",
  "description": "Read-only directory of healthcare conferences (Medicare, Medicaid, payer, quality) for AI agents. List, search, locate, and calendar-export curated, upcoming-by-default events.",
  "version": "0.1.1",
  "repository": {
    "url": "https://github.com/healthleader/cli",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@healthleader/cli",
      "version": "0.1.1",
      "transport": { "type": "stdio" },
      "runtimeHint": "npx",
      "runtimeArguments": [{ "type": "named", "name": "-y" }],
      "packageArguments": [{ "type": "positional", "value": "mcp" }]
    }
  ]
}
